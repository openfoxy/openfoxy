# syntax=docker/dockerfile:1
# Full host simulation: OpenRC manages services exactly as on an Alpine server.
FROM alpine:3.24
ARG TARGETARCH
ARG MTG_VERSION=2.2.8
RUN apk add --no-cache \
      nodejs squid apache2-utils dante-server curl tar iptables iproute2 bash openrc shadow \
    && mkdir -p /run/openrc && touch /run/openrc/softlevel \
    && curl -fsSL "https://github.com/9seconds/mtg/releases/download/v${MTG_VERSION}/mtg-${MTG_VERSION}-linux-${TARGETARCH}.tar.gz" \
    | tar -xz -C /tmp \
    && mv /tmp/mtg-*/mtg /usr/local/bin/mtg

WORKDIR /app
COPY package.json ./
COPY bin ./bin
COPY src ./src
RUN ln -s /app/bin/openfoxy.js /usr/local/bin/openfoxy

COPY e2e/ /e2e/
RUN chmod +x /e2e/*.sh /e2e/tests/*.sh

ENTRYPOINT ["bash"]
