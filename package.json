{
  "name": "openfoxy",
  "version": "2.0.1",
  "description": "Self-hosted HTTP, SOCKS5, MTProto, and residential proxy manager for Linux servers",
  "type": "module",
  "bin": {
    "openfoxy": "bin/openfoxy.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm test",
    "test:e2e": "docker compose -f e2e/docker-compose.yml up --build --abort-on-container-exit --exit-code-from server",
    "test:e2e:residential": "docker compose -f e2e/docker-compose.two-container.yml up --build --abort-on-container-exit --exit-code-from server",
    "test:browser": "docker compose -f e2e/docker-compose.browser.yml up --build -d && node e2e/browser/extension.e2e.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html,sh}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfoxy/openfoxy.git"
  },
  "keywords": [
    "proxy",
    "squid",
    "socks5",
    "dante",
    "mtproto",
    "residential-proxy",
    "networking"
  ],
  "author": "Max Ymlev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-sh": "^0.20.2"
  }
}
